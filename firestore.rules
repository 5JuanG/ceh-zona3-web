rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Paso 2: solo cuentas reales de Firebase Authentication (correo +
    // contraseña) dadas de alta por el Administrador pueden leer/escribir.
    // Se excluye explícitamente el proveedor anónimo (por si quedó
    // habilitado en la consola) para que ya no sirva como puerta trasera.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
  }
}
